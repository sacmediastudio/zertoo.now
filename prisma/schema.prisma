// ⚠️ MUY IMPORTANTE — leer antes de tocar esto:
//
// Este proyecto comparte la MISMA base de datos que el proyecto
// principal de Zertoo (saas-platform) — no es una base de datos
// propia. Este archivo declara SOLO el subconjunto de modelos y
// campos que Zertoo Eats necesita leer/escribir — a propósito NO
// incluye toda la tabla real completa (que tiene muchos más campos
// del lado del proyecto principal).
//
// Por eso:
//   1. NUNCA correr `prisma db push` ni `prisma migrate` desde ESTE
//      proyecto — sincronizaría la base de datos para que coincida
//      con ESTE esquema recortado, y podría BORRAR columnas reales
//      que el proyecto principal sí necesita. El único lugar donde
//      corresponde correr eso es en saas-platform.
//   2. Si el proyecto principal le agrega un campo NUEVO a Tenant o
//      Review, este archivo no se entera solo — hay que copiarlo acá
//      a mano si Zertoo Eats también lo va a usar.
//   3. Los nombres de campo/tabla (@map, @@map) tienen que coincidir
//      EXACTO con saas-platform/prisma/schema.prisma, porque apuntan
//      a las mismas columnas reales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NowCategory {
  ITALIAN
  FRENCH
  LOCAL
  COLOMBIAN
  MEXICAN
  INTERNATIONAL
  ASIAN
  JAPANESE
  CHINESE
  INDIAN
  STEAKHOUSE
  SEAFOOD
  SUSHI
  PIZZERIA
  BURGERS
  FAST_FOOD
  BBQ_GRILL
  CAFE
  BAKERY_PASTRY
  BREAKFAST_BRUNCH
  ICE_CREAM_GELATO
  DESSERTS
  VEGETARIAN_VEGAN
  BAR_PUB
  BEACH_BAR
  FOOD_TRUCK
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

// Mismos 3 valores exactos que el enum real en saas-platform — tiene
// que coincidir, porque apunta a la misma columna real.
enum BusinessType {
  RESTAURANT
  SMALL_BUSINESS
  SMARTLINK
}

// Subconjunto de Tenant — solo los campos que Zertoo Eats muestra o
// filtra. El resto de columnas reales (facturación, WhatsApp, etc.)
// existen en la base de datos igual, simplemente este proyecto no
// necesita saber de ellas.
model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType BusinessType
  logoUrl      String?
  heroImageUrl String?
  address      String?
  contactPhone String?

  nowEnabled  Boolean      @default(false)
  nowCategory NowCategory?
  nowFeatured Boolean      @default(false)
  latitude    Float?
  longitude   Float?

  reviews Review[]
  moments Moment[]

  @@map("tenants")
}

model Review {
  id       String       @id @default(cuid())
  tenantId String
  rating   Int
  status   ReviewStatus @default(PUBLISHED)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Moment {
  id            String    @id @default(cuid())
  tenantId      String
  imageUrl      String
  submitterName String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("moments")
}
